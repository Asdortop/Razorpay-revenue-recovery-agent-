# ─── Razorpay API Credentials ────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys → Test Mode

RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE

# ─── Razorpay Webhook Secret ──────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → Webhooks → + Add New
# Set the webhook URL to: https://YOUR_DOMAIN/webhook/razorpay
# Subscribe to: payment.captured, payment.authorized
# Copy the generated secret here.
# For LOCAL TESTING: leave blank — the server skips verification automatically.

RAZORPAY_WEBHOOK_SECRET=

# ─── Groq API (LLM Diagnosis) ─────────────────────────────────────────────────
# Get from: https://console.groq.com/keys (free tier, no credit card)

GROQ_API_KEY=gsk_YOUR_GROQ_KEY_HERE

# ─── Flask ───────────────────────────────────────────────────────────────────
# Change this to a random string in production

FLASK_SECRET_KEY=change-me-in-production
